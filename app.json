{
  "expo": {
    "name": "SATUOS",
    "slug": "satuos",
    "scheme": "satuos",
    "version": "1.1.0",
    "icon": "./assets/images/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070B16"
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-video",
      [
        "expo-sqlite",
        {
          "enableFTS": false
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "id.mazkiplay.satuos",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#070B16"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
